# Self-contained multi-stage build for a Backrest fork with local patches applied.
# Unlike the upstream Dockerfile.alpine (which expects pre-built binaries staged
# by goreleaser), this Dockerfile builds everything from source inside Docker,
# so nothing needs to be installed on the host beyond Docker itself.
#
# Usage (from the repo root of your fork, after applying the patch):
#   docker build -f Dockerfile.custom -t backrest-diff:custom .

# ---- Stage 1: build the web UI (Node/pnpm) ----
FROM node:22-alpine AS webui-builder
WORKDIR /app/webui
RUN corepack enable && corepack prepare pnpm@10 --activate
COPY webui/package.json webui/pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile || pnpm install
COPY webui/ ./
RUN pnpm run build

# ---- Stage 2: build the Go binaries ----
FROM golang:1.26-alpine AS go-builder
WORKDIR /app
RUN apk add --no-cache git
COPY . .
# Overlay the freshly built web UI so it gets embedded via //go:embed dist
# (see webui/webuinix.go) into the backrest binary.
COPY --from=webui-builder /app/webui/dist ./webui/dist
RUN go mod download
RUN CGO_ENABLED=0 go build -ldflags "-s -w" -o /out/backrest ./cmd/backrest
RUN CGO_ENABLED=0 go build -ldflags "-s -w" -o /out/docker-entrypoint ./cmd/docker-entrypoint

# ---- Stage 3: runtime image (mirrors upstream Dockerfile.alpine) ----
FROM alpine:latest
LABEL org.opencontainers.image.source="https://github.com/YOUR-USERNAME/backrest"
RUN apk --no-cache add tini ca-certificates curl bash rclone openssh tzdata docker-cli && \
    rclone selfupdate --stable
RUN mkdir -p /tmp

COPY --from=go-builder /out/backrest /backrest
COPY --from=go-builder /out/docker-entrypoint /docker-entrypoint

# Installs restic (backrest downloads/manages its own pinned restic version)
RUN /backrest --install-deps-only
RUN mkdir -p /bin && mv /root/.local/share/backrest/restic /bin/restic

ENTRYPOINT ["/sbin/tini", "--", "/docker-entrypoint"]
CMD ["/backrest"]
